#!/usr/bin/env bash
# al-compile - Smart wrapper for AL Language compiler
# Auto-detects workspace structure, analyzers, and package paths
# Version: 2.0.0

set -euo pipefail

VERSION="2.0.0"

# Detect platform
detect_platform() {
    local os_type=""

    # Check for Windows using multiple methods
    if [[ -n "${OS:-}" ]] && [[ "$OS" == "Windows_NT" ]]; then
        os_type="windows"
    elif [[ "$(uname -s 2>/dev/null)" == "MINGW"* ]] || [[ "$(uname -s 2>/dev/null)" == "MSYS"* ]]; then
        os_type="windows"
    elif [[ "$(uname -s 2>/dev/null)" == "Linux" ]]; then
        # Check if we're in WSL
        if grep -qiE '(microsoft|wsl)' /proc/version 2>/dev/null; then
            os_type="wsl"
        else
            os_type="linux"
        fi
    elif [[ "$(uname -s 2>/dev/null)" == "Darwin" ]]; then
        os_type="darwin"
    else
        os_type="linux"  # Default to Linux
    fi

    echo "$os_type"
}

PLATFORM=$(detect_platform)

# Set platform-specific paths
case "$PLATFORM" in
    windows)
        # Git Bash/MSYS2 on Windows - use Windows paths
        VSCODE_EXT_BASE="${USERPROFILE:-$HOME}/.vscode/extensions"
        COMPILER_BIN="bin/win32/alc.exe"
        ;;
    wsl)
        # WSL - use Linux paths for WSL filesystem
        VSCODE_EXT_BASE="$HOME/.vscode/extensions"
        COMPILER_BIN="bin/linux/alc"
        ;;
    darwin)
        # macOS
        VSCODE_EXT_BASE="$HOME/.vscode/extensions"
        COMPILER_BIN="bin/darwin/alc"
        ;;
    *)
        # Linux (default)
        VSCODE_EXT_BASE="$HOME/.vscode/extensions"
        COMPILER_BIN="bin/linux/alc"
        ;;
esac

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Default options
PROJECT_DIR=""
CLEAN=false
ANALYZERS="default"  # default, all, none, or comma-separated list
ERROR_LOG=".dev/compile-errors.log"
VERBOSE=false
QUIET=false
PARALLEL=true
ENABLE_RULESETS=true

# Function to print colored messages (suppressed in --quiet mode, except error)
info() { $QUIET || echo -e "${BLUE}ℹ${NC} $*"; }
success() { $QUIET || echo -e "${GREEN}✓${NC} $*"; }
warning() { $QUIET || echo -e "${YELLOW}⚠${NC} $*"; }
error() { echo -e "${RED}✗${NC} $*" >&2; }

# Show usage
usage() {
    cat <<EOF
al-compile v${VERSION} - Smart AL compiler wrapper

Usage: al-compile [OPTIONS]

Auto-detects workspace structure, analyzers, and package paths.

OPTIONS:
    --clean              Clean .alpackages before compiling
    --analyzers <mode>   Analyzer mode: default, all, none, or comma-separated list
                         default: CodeCop, UICop, PerTenantExtensionCop,
                                  ALCops (LinterCop, ApplicationCop, FormattingCop,
                                  PlatformCop, DocumentationCop, TestAutomationCop),
                                  TestQualityCop, ClaudeCodeCop
                                  (+ AppSourceCop if AppSourceCop.json exists)
                         all: All available analyzers including AppSourceCop
                         none: No analyzers
                         list: CodeCop,UICop,ALCopsLinter (custom selection)
                         Entries can also be absolute DLL paths:
                           /path/to/MyAnalyzer.dll
                           CodeCop,/path/to/MyAnalyzer.dll
    --output <file>      Error log output file (default: .dev/compile-errors.log)
    --no-parallel        Disable parallel compilation
    --no-rulesets        Disable external ruleset support
    --verbose, -v        Verbose output
    --quiet, -q          Suppress info/banner output. On failure, emit only a
                         clean error list (one diagnostic per line) to stderr.
                         Designed for hooks and scripts that want minimal noise.
    --version            Show version information
    --help, -h           Show this help

EXAMPLES:
    al-compile                                    # Basic compile with default analyzers
    al-compile --clean                            # Clean and compile
    al-compile --analyzers all                    # Compile with all analyzers
    al-compile --analyzers CodeCop,UICop          # Compile with specific named analyzers
    al-compile --analyzers /path/to/Foo.dll       # Run only one hard-coded analyzer
    al-compile --analyzers none                   # Compile without any analyzers
    al-compile --output errors.json               # Custom error log location

EOF
    exit 0
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --dir)
            PROJECT_DIR="$2"
            shift 2
            ;;
        --clean)
            CLEAN=true
            shift
            ;;
        --analyzers)
            ANALYZERS="$2"
            shift 2
            ;;
        --output)
            ERROR_LOG="$2"
            shift 2
            ;;
        --no-parallel)
            PARALLEL=false
            shift
            ;;
        --no-rulesets)
            ENABLE_RULESETS=false
            shift
            ;;
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        -q|--quiet)
            QUIET=true
            shift
            ;;
        --version)
            echo "al-compile v${VERSION}"
            exit 0
            ;;
        -h|--help)
            usage
            ;;
        *)
            error "Unknown option: $1"
            echo "Use --help for usage information"
            exit 1
            ;;
    esac
done

# Resolve --dir to a project root containing app.json
if [[ -n "$PROJECT_DIR" ]]; then
    SEARCH=$(realpath "$PROJECT_DIR" 2>/dev/null || echo "$PROJECT_DIR")
    [[ -f "$SEARCH" ]] && SEARCH=$(dirname "$SEARCH")
    while [[ "$SEARCH" != "/" ]]; do
        if [[ -f "$SEARCH/app.json" ]]; then
            cd "$SEARCH"
            break
        fi
        SEARCH=$(dirname "$SEARCH")
    done
    if [[ ! -f "app.json" ]]; then
        error "No app.json found above: $PROJECT_DIR"
        exit 1
    fi
fi

# Verify we're in an AL project
if [[ ! -f "app.json" ]]; then
    error "Not in an AL project directory (app.json not found)"
    error "Use --dir <path> to specify a file or directory inside the project"
    exit 1
fi

# Read project name from app.json
PROJECT_NAME=$(jq -r '.name // "Unknown"' app.json 2>/dev/null || echo "Unknown")
info "Project: $PROJECT_NAME"

# Find AL extension and analyzers
if $VERBOSE; then
    info "Searching for AL extension..."
fi

AL_EXT_DIR=$(find "$VSCODE_EXT_BASE"/ms-dynamics-smb.al-* -maxdepth 0 -type d 2>/dev/null | sort -V | tail -1)

if [[ -z "$AL_EXT_DIR" ]]; then
    error "AL extension not found in $VSCODE_EXT_BASE"
    error "Please install the AL Language extension for VS Code"
    exit 1
fi

ANALYZER_DIR="$AL_EXT_DIR/bin/Analyzers"
AL_VERSION=$(basename "$AL_EXT_DIR" | sed 's/ms-dynamics-smb.al-//')

if $VERBOSE; then
    info "Platform: $PLATFORM"
    info "AL Extension: $AL_VERSION"
    info "Analyzers: $ANALYZER_DIR"
fi

# Verify analyzers directory exists
if [[ ! -d "$ANALYZER_DIR" ]]; then
    error "Analyzers directory not found: $ANALYZER_DIR"
    exit 1
fi

# Use compiler from extension (matches analyzer version)
AL_COMPILER="$AL_EXT_DIR/$COMPILER_BIN"

# Make sure compiler is executable
if [[ ! -x "$AL_COMPILER" ]]; then
    chmod +x "$AL_COMPILER" 2>/dev/null || true
fi

# Verify compiler exists and is executable
if [[ ! -x "$AL_COMPILER" ]]; then
    error "AL compiler not found or not executable: $AL_COMPILER"
    error "Please ensure the AL extension is properly installed"
    exit 1
fi

if $VERBOSE; then
    COMPILER_VERSION=$("$AL_COMPILER" version 2>&1 | grep "version" | head -1 || echo "Unknown")
    info "Compiler: $COMPILER_VERSION"
fi

# Detect workspace structure
WORKSPACE_FILE=$(find .. ../.. -maxdepth 1 -name "*.code-workspace" 2>/dev/null | head -1)

if [[ -n "$WORKSPACE_FILE" ]]; then
    info "Multi-app workspace detected: $(basename "$WORKSPACE_FILE")"
    WORKSPACE_ROOT=$(dirname "$WORKSPACE_FILE")

    # Find all .alpackages directories in workspace (search deep enough for nested apps)
    PACKAGE_DIRS=$(find "$WORKSPACE_ROOT" -maxdepth 4 -type d -name ".alpackages" 2>/dev/null)

    if [[ -z "$PACKAGE_DIRS" ]]; then
        warning "No .alpackages directories found in workspace"
        PACKAGE_PATH=".alpackages"
    else
        # Build semicolon-separated path list (AL compiler format)
        PACKAGE_PATH=$(echo "$PACKAGE_DIRS" | tr '\n' ';' | sed 's/;$//')

        if $VERBOSE; then
            info "Package paths:"
            echo "$PACKAGE_DIRS" | while read -r dir; do
                echo "  - $dir"
            done
        fi
    fi
else
    info "Single-app project"
    PACKAGE_PATH=".alpackages"
fi

# Verify package cache exists
if [[ ! -d ".alpackages" ]]; then
    warning ".alpackages directory not found"
    warning "Run 'AL: Download Symbols' in VS Code first"
fi

# Clean if requested
if $CLEAN; then
    info "Cleaning .alpackages..."
    if [[ -d ".alpackages" ]]; then
        rm -rf .alpackages/*
        success "Cleaned package cache"
    fi
fi

# Build analyzer arguments based on mode
ANALYZER_ARGS=()

# Available analyzers (Microsoft built-ins)
CODECOP="$ANALYZER_DIR/Microsoft.Dynamics.Nav.CodeCop.dll"
UICOP="$ANALYZER_DIR/Microsoft.Dynamics.Nav.UICop.dll"
PERTENANT="$ANALYZER_DIR/Microsoft.Dynamics.Nav.PerTenantExtensionCop.dll"
APPSOURCE="$ANALYZER_DIR/Microsoft.Dynamics.Nav.AppSourceCop.dll"
TESTQUALITYCOP="$ANALYZER_DIR/BusinessCentral.TestQualityCop.dll"
CLAUDECODECOP="$ANALYZER_DIR/BusinessCentral.ClaudeCodeCop.dll"

# ALCops analyzers — bundled in the AL extension (version-matched to the compiler)
ALCOPS_DIR="$ANALYZER_DIR"
if $VERBOSE; then
    info "ALCops: bundled in AL extension ($ALCOPS_DIR)"
fi
ALCOPS_COMMON="$ALCOPS_DIR/ALCops.Common.dll"
ALCOPS_LINTERCOP="$ALCOPS_DIR/ALCops.LinterCop.dll"
ALCOPS_APPLICATIONCOP="$ALCOPS_DIR/ALCops.ApplicationCop.dll"
ALCOPS_FORMATTINGCOP="$ALCOPS_DIR/ALCops.FormattingCop.dll"
ALCOPS_PLATFORMCOP="$ALCOPS_DIR/ALCops.PlatformCop.dll"
ALCOPS_DOCUMENTATIONCOP="$ALCOPS_DIR/ALCops.DocumentationCop.dll"
ALCOPS_TESTAUTOMATIONCOP="$ALCOPS_DIR/ALCops.TestAutomationCop.dll"

# Validate ALCops installation when it will be used (default/all modes only)
if [[ "$ANALYZERS" == "default" || "$ANALYZERS" == "all" ]] && [[ ! -f "$ALCOPS_LINTERCOP" ]]; then
    echo
    error "ALCops analyzers not found in AL extension: $ALCOPS_DIR"
    warning "Ensure the AL Language extension is up to date"
    warning "To skip ALCops: al-compile --analyzers none"
    echo
    exit 1
fi

case "$ANALYZERS" in
    none)
        info "Analyzers: None"
        ;;
    all)
        info "Analyzers: All"
        [[ -f "$CODECOP" ]] && ANALYZER_ARGS+=("/analyzer:$CODECOP")
        [[ -f "$UICOP" ]] && ANALYZER_ARGS+=("/analyzer:$UICOP")
        [[ -f "$PERTENANT" ]] && ANALYZER_ARGS+=("/analyzer:$PERTENANT")
        [[ -f "$APPSOURCE" ]] && ANALYZER_ARGS+=("/analyzer:$APPSOURCE")
        [[ -f "$ALCOPS_COMMON" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_COMMON")
        [[ -f "$ALCOPS_LINTERCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_LINTERCOP")
        [[ -f "$ALCOPS_APPLICATIONCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_APPLICATIONCOP")
        [[ -f "$ALCOPS_FORMATTINGCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_FORMATTINGCOP")
        [[ -f "$ALCOPS_PLATFORMCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_PLATFORMCOP")
        [[ -f "$ALCOPS_DOCUMENTATIONCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_DOCUMENTATIONCOP")
        [[ -f "$ALCOPS_TESTAUTOMATIONCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_TESTAUTOMATIONCOP")
        [[ -f "$TESTQUALITYCOP" ]] && ANALYZER_ARGS+=("/analyzer:$TESTQUALITYCOP")
        [[ -f "$CLAUDECODECOP" ]] && ANALYZER_ARGS+=("/analyzer:$CLAUDECODECOP")
        ;;
    default)
        # Auto-include AppSourceCop if config exists
        if [[ -f "AppSourceCop.json" ]]; then
            info "Analyzers: Default (CodeCop, UICop, PerTenantExtensionCop, ALCops, TestQualityCop, ClaudeCodeCop, AppSourceCop)"
            [[ -f "$CODECOP" ]] && ANALYZER_ARGS+=("/analyzer:$CODECOP")
            [[ -f "$UICOP" ]] && ANALYZER_ARGS+=("/analyzer:$UICOP")
            [[ -f "$PERTENANT" ]] && ANALYZER_ARGS+=("/analyzer:$PERTENANT")
            [[ -f "$ALCOPS_COMMON" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_COMMON")
            [[ -f "$ALCOPS_LINTERCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_LINTERCOP")
            [[ -f "$ALCOPS_APPLICATIONCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_APPLICATIONCOP")
            [[ -f "$ALCOPS_FORMATTINGCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_FORMATTINGCOP")
            [[ -f "$ALCOPS_PLATFORMCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_PLATFORMCOP")
            [[ -f "$ALCOPS_DOCUMENTATIONCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_DOCUMENTATIONCOP")
            [[ -f "$ALCOPS_TESTAUTOMATIONCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_TESTAUTOMATIONCOP")
            [[ -f "$TESTQUALITYCOP" ]] && ANALYZER_ARGS+=("/analyzer:$TESTQUALITYCOP")
            [[ -f "$CLAUDECODECOP" ]] && ANALYZER_ARGS+=("/analyzer:$CLAUDECODECOP")
            [[ -f "$APPSOURCE" ]] && ANALYZER_ARGS+=("/analyzer:$APPSOURCE")
        else
            info "Analyzers: Default (CodeCop, UICop, PerTenantExtensionCop, ALCops, TestQualityCop, ClaudeCodeCop)"
            [[ -f "$CODECOP" ]] && ANALYZER_ARGS+=("/analyzer:$CODECOP")
            [[ -f "$UICOP" ]] && ANALYZER_ARGS+=("/analyzer:$UICOP")
            [[ -f "$PERTENANT" ]] && ANALYZER_ARGS+=("/analyzer:$PERTENANT")
            [[ -f "$ALCOPS_COMMON" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_COMMON")
            [[ -f "$ALCOPS_LINTERCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_LINTERCOP")
            [[ -f "$ALCOPS_APPLICATIONCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_APPLICATIONCOP")
            [[ -f "$ALCOPS_FORMATTINGCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_FORMATTINGCOP")
            [[ -f "$ALCOPS_PLATFORMCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_PLATFORMCOP")
            [[ -f "$ALCOPS_DOCUMENTATIONCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_DOCUMENTATIONCOP")
            [[ -f "$ALCOPS_TESTAUTOMATIONCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_TESTAUTOMATIONCOP")
            [[ -f "$TESTQUALITYCOP" ]] && ANALYZER_ARGS+=("/analyzer:$TESTQUALITYCOP")
            [[ -f "$CLAUDECODECOP" ]] && ANALYZER_ARGS+=("/analyzer:$CLAUDECODECOP")
        fi
        ;;
    *)
        # Custom comma-separated list
        info "Analyzers: Custom ($ANALYZERS)"
        IFS=',' read -ra ANALYZER_LIST <<< "$ANALYZERS"
        for analyzer in "${ANALYZER_LIST[@]}"; do
            analyzer=$(echo "$analyzer" | xargs) # trim whitespace
            case "$analyzer" in
                CodeCop)
                    [[ -f "$CODECOP" ]] && ANALYZER_ARGS+=("/analyzer:$CODECOP")
                    ;;
                UICop)
                    [[ -f "$UICOP" ]] && ANALYZER_ARGS+=("/analyzer:$UICOP")
                    ;;
                PerTenantExtensionCop|PerTenant)
                    [[ -f "$PERTENANT" ]] && ANALYZER_ARGS+=("/analyzer:$PERTENANT")
                    ;;
                AppSourceCop|AppSource)
                    [[ -f "$APPSOURCE" ]] && ANALYZER_ARGS+=("/analyzer:$APPSOURCE")
                    ;;
                ALCops|alcops)
                    [[ -f "$ALCOPS_COMMON" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_COMMON")
                    [[ -f "$ALCOPS_LINTERCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_LINTERCOP")
                    [[ -f "$ALCOPS_APPLICATIONCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_APPLICATIONCOP")
                    [[ -f "$ALCOPS_FORMATTINGCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_FORMATTINGCOP")
                    [[ -f "$ALCOPS_PLATFORMCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_PLATFORMCOP")
                    [[ -f "$ALCOPS_DOCUMENTATIONCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_DOCUMENTATIONCOP")
                    [[ -f "$ALCOPS_TESTAUTOMATIONCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_TESTAUTOMATIONCOP")
                    ;;
                ALCopsLinter|LinterCop|Linter)
                    [[ -f "$ALCOPS_LINTERCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_LINTERCOP")
                    ;;
                ALCopsApplication|ApplicationCop)
                    [[ -f "$ALCOPS_APPLICATIONCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_APPLICATIONCOP")
                    ;;
                ALCopsFormatting|FormattingCop)
                    [[ -f "$ALCOPS_FORMATTINGCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_FORMATTINGCOP")
                    ;;
                ALCopsPlatform|PlatformCop)
                    [[ -f "$ALCOPS_PLATFORMCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_PLATFORMCOP")
                    ;;
                ALCopsDocumentation|DocumentationCop)
                    [[ -f "$ALCOPS_DOCUMENTATIONCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_DOCUMENTATIONCOP")
                    ;;
                ALCopsTestAutomation|TestAutomationCop)
                    [[ -f "$ALCOPS_TESTAUTOMATIONCOP" ]] && ANALYZER_ARGS+=("/analyzer:$ALCOPS_TESTAUTOMATIONCOP")
                    ;;
                TestQualityCop|TestQuality)
                    [[ -f "$TESTQUALITYCOP" ]] && ANALYZER_ARGS+=("/analyzer:$TESTQUALITYCOP")
                    ;;
                ClaudeCodeCop|Claude)
                    [[ -f "$CLAUDECODECOP" ]] && ANALYZER_ARGS+=("/analyzer:$CLAUDECODECOP")
                    ;;
                *)
                    # Check if it looks like a file path (absolute, relative, or .dll extension)
                    if [[ "$analyzer" == /* ]] || [[ "$analyzer" == ./* ]] || [[ "$analyzer" == ../* ]] || [[ "$analyzer" == *.dll ]]; then
                        # Expand tilde if present
                        expanded="${analyzer/#\~/$HOME}"
                        if [[ -f "$expanded" ]]; then
                            ANALYZER_ARGS+=("/analyzer:$expanded")
                        else
                            warning "Analyzer DLL not found: $analyzer"
                        fi
                    else
                        warning "Unknown analyzer: $analyzer"
                    fi
                    ;;
            esac
        done
        ;;
esac

# Auto-discover custom analyzers in local .analyzers folder
if [[ -d ".analyzers" ]]; then
    CUSTOM_ANALYZERS=()
    while IFS= read -r -d '' analyzer; do
        CUSTOM_ANALYZERS+=("$analyzer")
        ANALYZER_ARGS+=("/analyzer:$analyzer")
    done < <(find .analyzers -maxdepth 1 -name "*.dll" -print0 2>/dev/null)

    if [[ ${#CUSTOM_ANALYZERS[@]} -gt 0 ]]; then
        info "Custom analyzers: ${CUSTOM_ANALYZERS[*]}"
    fi
fi

# Check if AppSourceCop is enabled and warn if config is missing
USING_APPSOURCECOP=false
for arg in "${ANALYZER_ARGS[@]}"; do
    if [[ "$arg" == *"AppSourceCop"* ]]; then
        USING_APPSOURCECOP=true
        break
    fi
done

if $USING_APPSOURCECOP; then
    if [[ ! -f "AppSourceCop.json" ]]; then
        echo
        warning "AppSourceCop is enabled but AppSourceCop.json not found"
        warning "AppSourceCop diagnostics will be silently hidden without this config file"
        warning "Create AppSourceCop.json next to app.json with mandatory properties:"
        echo "  {"
        echo "    \"mandatoryAffixes\": [\"YourPrefix\"],"
        echo "    \"supportedCountries\": [\"US\"]"
        echo "  }"
        echo
    fi
fi

# Find ruleset file
RULESET=""
if [[ -n "$WORKSPACE_FILE" ]]; then
    WORKSPACE_ROOT=$(dirname "$WORKSPACE_FILE")
    if [[ -f "$WORKSPACE_ROOT/custom.ruleset.json" ]]; then
        RULESET="$WORKSPACE_ROOT/custom.ruleset.json"
    fi
fi

# Fallback to local rulesets (prefer custom.ruleset.json over AppSourceCop.json)
if [[ -z "$RULESET" ]]; then
    if [[ -f "custom.ruleset.json" ]]; then
        RULESET="$(pwd)/custom.ruleset.json"
    elif [[ -f "../custom.ruleset.json" ]]; then
        RULESET="$(cd .. && pwd)/custom.ruleset.json"
    fi
fi

if [[ -n "$RULESET" ]]; then
    info "Ruleset: $(basename "$RULESET")"
else
    if $VERBOSE; then
        info "Ruleset: None"
    fi
fi

# Create .dev directory if needed
mkdir -p "$(dirname "$ERROR_LOG")"

# Build compilation command
COMPILE_CMD=(
    "$AL_COMPILER"
    /project:"."
    /packagecachepath:"$PACKAGE_PATH"
    "${ANALYZER_ARGS[@]}"
)

# Add ruleset if found
if [[ -n "$RULESET" ]]; then
    COMPILE_CMD+=(/ruleset:"$RULESET")
    if $ENABLE_RULESETS; then
        COMPILE_CMD+=(/enableexternalrulesets)
    fi
fi

# Add optional flags
if $PARALLEL; then
    COMPILE_CMD+=(/parallel)
fi

COMPILE_CMD+=(
    /reportsuppresseddiagnostics
    /errorlog:"$ERROR_LOG"
)

# Show command if verbose
if $VERBOSE; then
    info "Command:"
    printf '  %s\n' "${COMPILE_CMD[@]}"
    echo
fi

# Run compilation
info "Compiling..."
echo

COMPILE_RC=0
if $QUIET; then
    "${COMPILE_CMD[@]}" >/dev/null 2>&1 || COMPILE_RC=$?
else
    "${COMPILE_CMD[@]}" 2>&1 || COMPILE_RC=$?
fi

if [[ $COMPILE_RC -eq 0 ]]; then
    if ! $QUIET; then
        echo
        success "Compilation succeeded!"
    fi

    # Show summary if error log exists
    if [[ -f "$ERROR_LOG" ]]; then
        DIAGNOSTIC_COUNT=$(jq -r '.diagnostics | length' "$ERROR_LOG" 2>/dev/null || echo "0")
        if [[ "$DIAGNOSTIC_COUNT" -gt 0 ]]; then
            info "Diagnostics: $DIAGNOSTIC_COUNT (see $ERROR_LOG)"
        fi
    fi

    exit 0
else
    if $QUIET; then
        # Clean error-only output to stderr — designed for hooks/scripts
        if [[ -f "$ERROR_LOG" ]] && command -v jq &>/dev/null; then
            jq -r '.issues[] | select(.properties.severity == "Error") | .locations[0].analysisTarget[0] as $loc | "\($loc.uri):\($loc.region.startLine):\($loc.region.startColumn): \(.ruleId): \(.fullMessage)"' \
                "$ERROR_LOG" >&2 2>/dev/null || true
        else
            echo "Compilation failed (no error log at $ERROR_LOG)" >&2
        fi
        exit 1
    fi

    echo
    error "Compilation failed"

    if [[ -f "$ERROR_LOG" ]]; then
        info "Error log: $ERROR_LOG"

        # Try to parse and show error summary
        if command -v jq &>/dev/null; then
            ERROR_COUNT=$(jq -r '[.diagnostics[] | select(.severity == "Error")] | length' "$ERROR_LOG" 2>/dev/null || echo "?")
            WARNING_COUNT=$(jq -r '[.diagnostics[] | select(.severity == "Warning")] | length' "$ERROR_LOG" 2>/dev/null || echo "?")

            echo
            error "Errors: $ERROR_COUNT"
            warning "Warnings: $WARNING_COUNT"

            # Show first few errors
            echo
            info "First errors:"
            jq -r '.diagnostics[] | select(.severity == "Error") | "\(.code): \(.message) in \(.source)(\(.range.start.line),\(.range.start.character))"' "$ERROR_LOG" 2>/dev/null | head -5 || true
        fi
    fi

    exit 1
fi
